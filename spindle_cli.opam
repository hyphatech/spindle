# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "An application's command line: its API, described from the routes"
maintainer: ["Hypha Technologies Ltd <dev@hyphatech.io>"]
authors: ["Hypha Technologies Ltd"]
license: "MIT"
homepage: "https://github.com/hyphatech/spindle"
bug-reports: "https://github.com/hyphatech/spindle/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.4"}
  "spindle" {= version}
  "cmdliner" {>= "2.1.1"}
  "eio" {>= "1.6"}
  "eio_main" {>= "1.6"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/hyphatech/spindle.git"
x-maintenance-intent: ["(latest)"]
