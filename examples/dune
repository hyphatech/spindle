; Small programs, each showing one thing an application does with Spindle,
; for the documentation and the tutorials to point at. They are built with
; the repository, so an example that stops compiling as the framework
; changes is found by the build and not by a reader.

(executables
 (names
  hello
  greeting
  fahrenheit
  split
  path_params
  methods
  dependencies
  json_body
  logging
  api_cli
  bearer_auth
  access
  oauth
  mcp
  mcp_client
  mcp_journal
  mcp_watch
  middleware
  cookie
  session
  static
  openapi
  sse
  health
  websocket_server
  websocket_client
  sql_query
  sql_transaction
  sql_postgres
  multidomain)
 (libraries
  spindle
  spindle-client
  spindle-cli
  spindle-postgres
  spindle-sqlite
  spindle-mcp
  spindle-mcp-client
  rowtype
  rowtype-postgres
  rowtype-sqlite
  eio
  eio_main
  wiretype
  mtime
  ptime
  logs)
 (preprocess
  (pps ppx_wiretype)))

; @all builds only the modules a program links, so @all asks for this
; directory's @check, which compiles every module, a piece no program
; links among them.

(rule
 (alias all)
 (deps
  (alias check))
 (action (progn)))
