; The web framework. It reads and writes HTTP/1.1 itself, through
; `spindle_http`, over Eio's sockets: a handler sees our request, our
; response and our statuses, and nothing here links an HTTP library.

(library
 (name spindle)
 (public_name spindle)
 ; What the library itself uses and nothing outside it may: what a public
 ; module is underneath (each _repr); how a response is rendered and
 ; compressed, and how long a connection may wait; how a typed input is
 ; read, a precondition and a range answered, and a file typed; the routes
 ; walked and their JSON written for the two printers; and the reference
 ; page /docs serves. A package built on the framework reaches them through
 ; the public modules like anybody.
 (private_modules
  wire
  deadline
  body_repr
  input
  codec_repr
  path_repr
  dep_repr
  request_repr
  returns_repr
  route_repr
  cookie_repr
  key_repr
  out
  described
  scalar
  conditional
  cors_repr
  gzip
  compress_repr
  file_types
  melange_route
  outgoing)
 (libraries
  spindle_http
  eio
  eio.unix
  eio.mock
  cstruct
  optint
  mtime
  ptime
  ptime.clock.os
  uri
  wiretype
  uuidm
  ipaddr
  digestif
  mirage-crypto
  decompress.de
  checkseum
  checkseum.ocaml
  mirage-crypto-rng.unix
  base64
  logs
  unix
  threads.posix))

; Scalar, the reference /docs serves, as one script compiled into the
; library: it is served from the application's own origin, so the page works
; offline and under a content security policy that allows no other host. It
; is linked only into a program that serves the docs, as every module no
; program names is left out. The file is @scalar/api-reference 1.72.1's
; dist/browser/standalone.js (MIT), and replacing it is how its version
; changes.

(rule
 (target scalar.ml)
 (deps scalar/standalone.js)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let js = {scalar|")
    (cat %{deps})
    (echo "|scalar}\n")))))

; What every printed Melange client calls through, kept as the OCaml it is in
; melange/ and carried here as text, after the module wiretype prints.

(rule
 (target melange_route.ml)
 (deps melange/route.ml)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let text = {route|")
    (cat melange/route.ml)
    (echo "|route}\n")))))
