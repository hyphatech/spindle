# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Calling another server's tools over the Model Context Protocol, with no framework"
description:
  "MCP 2026-07-28 over HTTP on spindle-client alone: server/discover, tools/list and tools/call, typed by Wiretype descriptions or as plain JSON, a server's questions answered through a function. Its protocol library, spindle-mcp-client.protocol, is MCP's messages, which spindle-mcp's server is built on too."
maintainer: ["Hypha Technologies Ltd <dev@hyphatech.io>"]
authors: ["Hypha Technologies Ltd"]
license: "MIT"
homepage: "https://github.com/hyphatech/spindle"
bug-reports: "https://github.com/hyphatech/spindle/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.5"}
  "spindle-client" {= version}
  "spindle-http" {= version}
  "wiretype" {>= "0.6.1" & < "0.7.0"}
  "base64" {>= "3.5.2"}
  "logs" {>= "0.10.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/hyphatech/spindle.git"
x-maintenance-intent: ["(latest)"]
