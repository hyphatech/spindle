; Calling other servers: HTTPS with the system's trust store, a switch and a
; deadline per call. The only part of the framework that links the TLS
; stack, so an application that calls nobody compiles none of it.

(library
 (name spindle_client)
 (public_name spindle-client)
 (libraries
  spindle_http
  wiretype
  eio
  eio.unix
  ; A Unix socket, connected the same way on every system.
  unix
  cstruct
  iomux
  mtime
  ptime
  uri
  tls
  tls-eio
  x509
  ipaddr
  ca-certs
  mirage-crypto-rng
  mirage-crypto-rng.unix
  ; PKCE's S256 (RFC 7636 §4.2).
  digestif
  base64
  domain-name
  logs))
