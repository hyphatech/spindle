# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A web framework on Eio"
description:
  "Routes as values, dependencies that list what a route reads, failures as values, streams and WebSockets, the API described as OpenAPI and zod, and HTTP/1.1 read and written by itself. spindle.client calls other servers and links no framework."
maintainer: ["Hypha Technologies Ltd <dev@hyphatech.io>"]
authors: ["Hypha Technologies Ltd"]
license: "MIT"
homepage: "https://github.com/hyphatech/spindle"
bug-reports: "https://github.com/hyphatech/spindle/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.4"}
  "wiretype" {>= "0.1.0"}
  "ppx_wiretype" {>= "0.1.0"}
  "eio" {>= "1.5"}
  "eio_main" {>= "1.5"}
  "uri" {>= "4.4.0"}
  "angstrom" {>= "0.16.1"}
  "logs" {>= "0.10.0"}
  "mtime" {>= "2.1.0"}
  "cstruct" {>= "6.2.0"}
  "optint" {>= "0.3.0"}
  "digestif" {>= "1.3.1"}
  "base64" {>= "3.5.2"}
  "ipaddr" {>= "5.6.2"}
  "domain-name" {>= "0.5.0"}
  "tls-eio" {>= "2.1.2"}
  "iomux" {>= "0.4"}
  "x509" {>= "1.1.1"}
  "ca-certs" {>= "1.0.3"}
  "mirage-crypto" {>= "2.4.1"}
  "decompress" {>= "1.6.0"}
  "checkseum" {>= "0.5.3"}
  "mirage-crypto-rng" {>= "2.4.1"}
  "odoc" {with-dev-setup & >= "3.2.1"}
  "merlin" {with-dev-setup & >= "5.6-504"}
  "ocaml-lsp-server" {with-dev-setup & >= "1.24.0"}
  "ocamlformat" {with-dev-setup & = "0.29.0"}
  "htmlit" {with-dev-setup & >= "0.2.0"}
  "tyxml" {with-dev-setup & >= "5.0.0"}
  "tyxml-ppx" {with-dev-setup & >= "5.0.0"}
  "html_of_jsx" {with-dev-setup & >= "0.1.0"}
  "mlx" {with-dev-setup & >= "0.11"}
  "jingoo" {with-dev-setup & >= "1.5.4"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/hyphatech/spindle.git"
x-maintenance-intent: ["(latest)"]
