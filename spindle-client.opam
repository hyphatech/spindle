# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Calling other servers from Eio, over HTTPS, with no web framework"
description:
  "Calls, streamed bodies, Server-Sent Events and WebSockets, over HTTPS with the system's trust store, a switch and a deadline per call, on spindle-http alone."
maintainer: ["Hypha Technologies Ltd <dev@hyphatech.io>"]
authors: ["Hypha Technologies Ltd"]
license: "MIT"
homepage: "https://github.com/hyphatech/spindle"
bug-reports: "https://github.com/hyphatech/spindle/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.5"}
  "spindle-http" {= version}
  "wiretype" {>= "0.6.0" & < "0.7.0"}
  "eio" {>= "1.6"}
  "cstruct" {>= "6.2.0"}
  "iomux" {>= "0.4"}
  "mtime" {>= "2.1.0"}
  "ptime" {>= "1.2.0"}
  "uri" {>= "4.4.0"}
  "tls" {>= "2.1.2"}
  "tls-eio" {>= "2.1.2"}
  "x509" {>= "1.1.1"}
  "ipaddr" {>= "5.6.2"}
  "ca-certs" {>= "1.0.3"}
  "mirage-crypto-rng" {>= "2.4.1"}
  "base64" {>= "3.5.2"}
  "domain-name" {>= "0.5.0"}
  "logs" {>= "0.10.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/hyphatech/spindle.git"
x-maintenance-intent: ["(latest)"]
