# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "HTTP/1.1 as both ends speak it, on Eio: heads, bodies, fields, WebSockets"
description:
  "What Spindle's server and its client share: a message read off a connection and written to one, every framing RFC 9112 allows, the fields RFC 9110 gives a structure, Structured Fields, multipart and WebSockets. It holds no socket and applies no limit it is not given."
maintainer: ["Hypha Technologies Ltd <dev@hyphatech.io>"]
authors: ["Hypha Technologies Ltd"]
license: "MIT"
homepage: "https://github.com/hyphatech/spindle"
bug-reports: "https://github.com/hyphatech/spindle/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.5"}
  "wiretype" {>= "0.6.0" & < "0.7.0"}
  "eio" {>= "1.6"}
  "angstrom" {>= "0.16.1"}
  "logs" {>= "0.10.0"}
  "mtime" {>= "2.1.0"}
  "ptime" {>= "1.2.0"}
  "digestif" {>= "1.3.1"}
  "base64" {>= "3.5.2"}
  "ipaddr" {>= "5.6.2"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/hyphatech/spindle.git"
x-maintenance-intent: ["(latest)"]
