; Spindle's suites, and the Postgres kit's against SPINDLE_TEST_PG. Another
; server a test stands in is stub_server.ml; a database of a case's own is
; db_target.ml; a program that only serves, run as a process, is
; serve_app.ml; a server on virtual time, and connections to it in memory,
; is in_memory.ml; a certificate, and TLS before a server, is tls_front.ml;
; an instant a row gives in milliseconds is instants.ml.

(tests
 (names
  test_spindle
  test_openapi
  test_wire
  test_http_rfc
  test_websocket_rfc
  test_multipart_rfc
  test_websocket
  test_structured
  test_spindle_postgres
  test_oauth_rfc
  test_mcp_spec
  test_cli)
 (package spindle-postgres)
 (modules :standard \ cli_app serve_app test_docs test_spindle_sqlite)
 (libraries
  spindle
  spindle-http
  spindle-client
  spindle-postgres
  spindle-mcp
  spindle-mcp-client.protocol
  spindle-mcp-client
  rowtype
  rowtype-postgres
  wiretype
  logs
  threads.posix
  eio
  eio_main
  eio.mock
  eio.unix
  mtime
  mtime.clock
  ptime
  ptime.clock.os
  uri
  yojson
  alcotest
  fmt
  qcheck-core
  qcheck-alcotest
  ; The referee: a second HTTP/1.1 parser, to disagree with ours.
  httpun
  ; A second implementation of gzip, to read back what the server wrote.
  decompress.gz
  decompress.de
  angstrom
  cstruct
  ; The client's TLS rows: a server with a certificate the suite makes.
  tls
  tls-eio
  x509
  ipaddr
  mirage-crypto-rng.unix
  ; The OAuth rows sign what the server checks.
  mirage-crypto-ec
  base64
  unix)
 (deps
  ; RFC 9651's published tests, pinned, which test_structured runs whole.
  (source_tree structured-field-tests)
  ; The command line test_cli runs as a process.
  cli_app.exe
  ; Spindle.serve, which test_spindle runs as a process.
  serve_app.exe
  ; The sessions table's migration, which test_spindle_postgres holds to its
  ; schema.
  (glob_files ../postgres/migrations/*.sql)))

(executable
 (name cli_app)
 (modules cli_app)
 (libraries spindle spindle-cli))

(executable
 (name serve_app)
 (modules serve_app)
 (libraries spindle eio_main))

; Every example the build makes is on a page of the documentation site.

(test
 (name test_docs)
 (package spindle)
 (modules test_docs)
 (libraries alcotest)
 (deps
  ../examples/dune
  (glob_files_rec ../docs/src/content/*.{md,mdx})))

; The SQLite kit, against files of each case's own, which needs no server.

(test
 (name test_spindle_sqlite)
 (package spindle-sqlite)
 (modules test_spindle_sqlite)
 (deps
  (glob_files ../sqlite/migrations/*.sql))
 (libraries
  spindle
  spindle-http
  spindle-sqlite
  rowtype
  rowtype-sqlite
  wiretype
  logs
  eio
  eio_main
  mtime
  ptime
  alcotest))
